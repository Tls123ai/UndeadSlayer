# Local development works without credentials using persistent embedded Postgres.
# Leave this empty locally, or supply your PostgreSQL provider's connection URL.
# REQUIRED on Vercel/serverless and recommended for multi-instance deployments.
DATABASE_URL=

# Alternative supplied by Vercel PostgreSQL integrations. DATABASE_URL takes
# priority when both are set. Neither variable should be exposed as NEXT_PUBLIC_.
POSTGRES_URL=

# Optional locally; defaults to ./data/undead-slayer.
# For `next start` without DATABASE_URL, explicitly set this to a persistent
# directory on a single Node server (e.g. data/undead-slayer or a mounted volume).
# Embedded storage is intentionally disabled on Vercel/AWS Lambda.
PGLITE_DATA_DIR=
